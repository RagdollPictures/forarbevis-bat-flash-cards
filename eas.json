{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },

  "build": {
    "development-forarbevis": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "forarbevis"
      }
    },

    "development-jagarexamen": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "jagarexamen"
      }
    },

    "preview-forarbevis": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "forarbevis"
      }
    },

    "preview-jagarexamen": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "jagarexamen"
      }
    },

    "production-forarbevis": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "forarbevis"
      }
    },

    "production-jagarexamen": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "jagarexamen"
      }
    }
  },

  "submit": {
    "production-forarbevis": {},
    "production-jagarexamen": {}
  }
}